local function WaitFor(Check, Limit)
  local EndAt = os.clock() + (Limit or CFG.ActionTimeout)
  repeat
    local OK, Yes = pcall(Check)
    if OK and Yes then return true end
    task.wait(CFG.CheckPeriod)
  until os.clock() >= EndAt
  return false
end
local function IsComplete(Part)
  return NumberAttr(Part, "Damage") == 100
    and NumberAttr(Part, "Rust") == 0
end
local function LooseCandidates(Name)
  local Folder, Result = Loose(), {}
  if not Folder then return Result end

  for _, Part in ipairs(Folder:GetDescendants()) do
    if Part.Name == Name
      and (Part:IsA("Model") or Part:IsA("BasePart"))
      and NumberAttr(Part, "Damage") ~= nil then
      local NestedDuplicate = false
      local Parent = Part.Parent
      while Parent and Parent ~= Folder do
        if Parent.Name == Name
          and NumberAttr(Parent, "Damage") ~= nil then
          NestedDuplicate = true
          break
        end
        Parent = Parent.Parent
      end
      if not NestedDuplicate then
        table.insert(Result, Part)
      end
    end
  end
  return Result
end
local function InventorySnapshot(Excluded)
  local Inventory = {}
  local Folder = Loose()
  if not Folder then return Inventory end
  for _, Part in ipairs(Folder:GetDescendants()) do
    if StoreParts[Part.Name]
      and (Part:IsA("BasePart") or Part:IsA("Model"))
      and not (Excluded and Excluded[Part])
      and IsComplete(Part) then
      local Nested = false
      local Parent = Part.Parent
      while Parent and Parent ~= Folder do
        if Parent.Name == Part.Name and IsComplete(Parent) then
          Nested = true
          break
        end
        Parent = Parent.Parent
      end
      if not Nested then
        local Bucket = Inventory[Part.Name]
        if not Bucket then
          Bucket = {}
          Inventory[Part.Name] = Bucket
        end
        table.insert(Bucket, Part)
      end
    end
  end
  return Inventory
end
