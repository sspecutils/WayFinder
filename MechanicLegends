    return
  end
  if enabled or running then
    Window:Notify({title = "Customer Jobs running", content = "Turn off Customer Jobs before manually repairing your car.", duration = 5})
    return
  end
  ManualBusy = true
  local OK, Error = pcall(function()
    local Before = {}
    for _, Car in ipairs(Cars:GetChildren()) do Before[Car] = true end
    local Spawn = F:WaitForChild("RequestSpawnVehicle")
    local SpawnOK, Response = pcall(function() return Spawn:InvokeServer(Uuid) end)
    if not SpawnOK or Response == false then error("Vehicle spawn was rejected") end
    local Car
    if typeof(Response) == "Instance" and Response:IsA("Model") then Car = Response end
    local CarId = Owned.id
    local Deadline = os.clock() + 15
    repeat
      Car = Car or FindSpawnedCar(Uuid, CarId, Before)
      if Car then break end
      task.wait(0.2)
    until os.clock() >= Deadline
    if not Car then error("Spawned car could not be identified") end
    CarId = Car.Name
    local Engine = Find(Car:FindFirstChild("Misc"), "Engine")
    if not Engine then error("Spawned car has no Engine folder") end
    local Prefix = EngineIds[CarId]
    if not Prefix then error("Unknown DefaultEngineId for " .. CarId) end
    local Expected = ExpectedEngineParts(CarId, Engine)
    if not next(Expected) then error("Cannot determine which engine parts are required") end
    local Sequence = {}
    for _, Name in ipairs(EngineOrder) do
      if Expected[Name] then table.insert(Sequence, Name) end
    end
    local State = {
      required = {}, originallyDetached = {}, statuses = {}, repairList = {},
      problems = {}, excluded = {}, remoteSent = {}, attempts = {}
    }
    local Ctx = {car = Car, engine = Engine, sequence = Sequence,
      state = State, tasks = {required = {}, targets = Expected}}
    Disassemble(Ctx)
    BuildPlan(Ctx)
    State.required.Intercooler = nil
    local ScrappedParts = {}
    for Part in pairs(State.excluded) do
      if typeof(Part) == "Instance" and (NumberAttr(Part, "Damage") or 100) < 15 then
        table.insert(ScrappedParts, Part)
      end
    end
    for Name, Reason in pairs(State.problems) do
      error(Name .. ": " .. Reason)
    end
    if not CleanEngine(Ctx) then error("Engine cleaning incomplete") end
    local Missing = Shortages(Ctx)
    if next(Missing) then
      local Payload = {}
      for Name, Count in pairs(Missing) do
        if Name ~= "Intercooler" then
          local Id = StoreParts[Name]
          if not Id then error("Unknown component " .. Name) end
          table.insert(Payload, {Id = Prefix .. "-" .. Id .. "-stock", Class = "PartVariants", Count = Count})
        end
      end
      if #Payload == 0 then error("Only an optional intercooler is missing; no stock replacement will be ordered") end
      table.sort(Payload, function(A, B) return A.Id < B.Id end)
      local Stock = InventorySnapshot(State.excluded)
      local Counts = {}
      for Name in pairs(Missing) do Counts[Name] = Stock[Name] and #Stock[Name] or 0 end
      local Purchase = {beforeBoxes = {}, beforePending = PendingEntryIds()}
      for _, Box in ipairs(ExistingBoxes()) do Purchase.beforeBoxes[Box] = true end
      local Placed, Answer, Detail = pcall(function() return Order:InvokeServer(Payload) end)
      if not Placed or Answer == false then
        local Items = {}
        for _, Item in ipairs(Payload) do
          table.insert(Items, Item.Id .. " x" .. tostring(Item.Count))
        end
        local Reason = not Placed and tostring(Answer)
          or (Detail ~= nil and tostring(Detail) or "The server returned false")
        error("Stock order rejected (" .. tostring(CarId) .. ", " .. tostring(Prefix)
          .. "): " .. Reason .. ". Items: " .. table.concat(Items, ", "), 0)
      end
      local EndAt = os.clock() + CFG.DeliveryTimeout
      local Delivered = false
      while os.clock() < EndAt do
        local Received = InventorySnapshot(State.excluded)
        Delivered = true
        for Name, Count in pairs(Missing) do
          if (Received[Name] and #Received[Name] or 0) < Counts[Name] + Count then
            Delivered = false
            break
          end
        end
        if Delivered then break end
        local Box = FindOrderBox(Purchase)
        if Box then
          OpenBox(Box)
        end
        task.wait(0.5)
      end
      if not Delivered then error("Replacement delivery not confirmed; will not reorder automatically") end
    end
    if not Assemble(Ctx) then error("Engine assembly incomplete") end
    local Trash = F:FindFirstChild("TrashbinDeposit")
    local Discarded, Failed = 0, 0
    for _, Part in ipairs(ScrappedParts) do
      local Target = Part
      if Part.Parent == nil and typeof(getnilinstances) == "function" then
        local DebugId
        pcall(function() DebugId = Part:GetDebugId() end)
        if DebugId then
          local OK, NilParts = pcall(getnilinstances)
          if OK and typeof(NilParts) == "table" then
            for _, Candidate in ipairs(NilParts) do
              if Candidate.Name == Part.Name then
                local Same = false
                pcall(function() Same = Candidate:GetDebugId() == DebugId end)
                if Same then Target = Candidate break end
              end
            end
          end
        end
      end
      if Trash then
        local OK, Result = pcall(function() return Trash:InvokeServer("Shop", Target) end)
        if OK and Result ~= false then Discarded += 1 else Failed += 1 end
      else
        Failed += 1
      end
    end
    local Message = Car.Name .. " engine has been serviced."
    if #ScrappedParts > 0 then
      Message ..= " Discarded " .. Discarded .. " damaged part(s)."
      if Failed > 0 then Message ..= " " .. Failed .. " could not be discarded." end
    end
    Window:Notify({title = "Vehicle repaired", content = Message, duration = 7})
  end)
  if not OK then
    local Reason = tostring(Error):gsub("^.-:%d+: ", "")
    Window:Notify({title = "Repair stopped", content = Reason, duration = 10})
  end
  ManualBusy = false
end

