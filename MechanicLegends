local function Disassemble(Ctx)
  local State = Ctx.state

  for _, Name in ipairs(Ctx.sequence) do
    local Installed = Find(Ctx.engine, Name)
    if not Installed then
      State.statuses[Name] = "Absent"
      continue
    end
    local Before = {}
    for _, Part in ipairs(LooseCandidates(Name)) do Before[Part] = true end

    local OK = pcall(function()
      return Detach:InvokeServer(Installed)
    end)
    if not OK then
      State.statuses[Name] = "Failed"
      continue
    end
    local NewPart
    local Confirmed = WaitFor(function()
      for _, Part in ipairs(LooseCandidates(Name)) do
        if Part == Installed or not Before[Part] then
          NewPart = Part
          return true
        end
      end
      return false
    end)
    if Confirmed then
      State.originallyDetached[Name] = NewPart
      State.statuses[Name] = "Detached"
    else
      State.statuses[Name] = "Failed"
    end
    task.wait(CFG.ActionGap)
  end
end
local function BuildPlan(Ctx)
  local State = Ctx.state
  local Req = Ctx.tasks.required

  for Name, Count in pairs(Req) do State.required[Name] = Count end

  for _, Name in ipairs(Ctx.sequence) do
    local Original = State.originallyDetached[Name]
    local Status = State.statuses[Name]
    local Candidates = LooseCandidates(Name)
    if not Original then
      for _, Part in ipairs(Candidates) do
        if not IsComplete(Part) then Original = Part break end
      end
    end
    local Damage = NumberAttr(Original, "Damage")
    local Rust = NumberAttr(Original, "Rust")
    local RequiresStock = State.required[Name] ~= nil

    if Damage ~= nil and Damage < 15 then
      RequiresStock = true
      State.required[Name] = 1
    end
    local KnownOriginal = State.originallyDetached[Name]
    if KnownOriginal and RequiresStock then
      State.excluded[KnownOriginal] = true
    end
    if Original and Damage ~= nil and Damage < 15 then
      State.excluded[Original] = true
    end
    local HasReady = false
    for _, Part in ipairs(Candidates) do
      if not State.excluded[Part] and IsComplete(Part) then
        HasReady = true
        break
      end
    end
    if Status == "Failed" then
      State.problems[Name] = "Detachment failed; component may still be installed"
    elseif RequiresStock then
    elseif Original and Damage ~= nil and Rust ~= nil then
      table.insert(State.repairList, Original)
    elseif HasReady then
    elseif Status == "Absent" and Ctx.tasks.targets[Name] then
      State.required[Name] = 1
    else
      State.problems[Name] = "No suitable loose component or replacement task"
    end
  end
end
local function RepairStage(State, Part, Kind)
  local Key = Kind == "Rust" and "Rust" or "Damage"
  local function Done()
    local V = NumberAttr(Part, Key)
    return V and (Kind == "Rust" and V <= 0
      or Kind == "Wear" and V >= 100)
  end
  if Done() then return true end

  local Record = State.remoteSent[Part]
  if not Record then Record = {} State.remoteSent[Part] = Record end
  if Record[Kind] then
    return WaitFor(Done, 2)
  end
  Record[Kind] = true
  local OK = pcall(function()
    Repair:FireServer(Part, Kind)
  end)
  if not OK then
    return false
  end
  if not WaitFor(Done) then
    return false
  end
  return true
end
local function CleanEngine(Ctx)
  local List, State = Ctx.state.repairList, Ctx.state
  if #List == 0 then return true end

  local Jobs, Remaining, RustCount, PolishCount = {}, 0, 0, 0
  for _, Part in ipairs(List) do
    local Rust = (NumberAttr(Part, "Rust") or math.huge) > 0
    local Polish = (NumberAttr(Part, "Damage") or -math.huge) < 100
    Jobs[#Jobs + 1] = {part = Part, rust = Rust, polish = Polish, busy = false}
    if Rust then
      RustCount += 1
      Remaining += 1
    end
    if Polish then
      PolishCount += 1
      Remaining += 1
    end
  end

  local Failed, Finished, Aborted = {}, 0, false
  local function Work(Stage)
    while Remaining > 0 and not Aborted do
      local Job
      for _, Entry in ipairs(Jobs) do
        if Entry[Stage] and not Entry.busy then
          Entry[Stage] = false
          Entry.busy = true
          Remaining -= 1
          Job = Entry
          break
        end
      end
      if Job then
        local Kind = Stage == "rust" and "Rust" or "Wear"
        if not RepairStage(State, Job.part, Kind) then
          Failed[Job.part.Name] = Stage == "rust" and "Rust incomplete" or "Polishing incomplete"
        end
        Job.busy = false
      else
        task.wait(0.08)
      end
    end
  end

  local RustWorkers = math.min(CFG.MaxRust, RustCount)
  local PolishWorkers = math.min(CFG.MaxPolish, PolishCount)
  local WorkerCount = RustWorkers + PolishWorkers
  for _, Group in ipairs({{"rust", RustWorkers}, {"polish", PolishWorkers}}) do
    local Stage = Group[1]
    for _ = 1, Group[2] do
      task.spawn(function()
        local OK, Error = pcall(Work, Stage)
        if not OK then
          Failed.System = tostring(Error)
          Aborted = true
        end
        Finished += 1
      end)
    end
  end
  while Finished < WorkerCount do task.wait(0.1) end
  for _, Part in ipairs(List) do
    if not IsComplete(Part) then
      Failed[Part.Name] = Failed[Part.Name] or "Condition below 100/0"
    end
  end
  return next(Failed) == nil
end
local function ServiceBattery(Ctx)
  local Chassis = Find(Ctx.car, "ChassisParts")
  if not Chassis then return false, "ChassisParts missing" end

  local Installed = Find(Chassis, "Battery")
  local Battery
  if Installed then
    local Before = {}
    for _, Part in ipairs(LooseCandidates("Battery")) do Before[Part] = true end
    local OK, Error = pcall(function()
      DetachBattery:InvokeServer(Installed)
    end)
    if not OK then return false, tostring(Error) end
    if not WaitFor(function()
      for _, Part in ipairs(LooseCandidates("Battery")) do
        if Part == Installed or not Before[Part] then
          Battery = Part
          return true
        end
      end
    end) then
      return false, "Battery detachment not confirmed"
    end
  else
    Battery = LooseCandidates("Battery")[1]
    if not Battery then return false, "Battery missing" end
  end
  if (NumberAttr(Battery, "Damage") or -1) < 100 then
    local OK, Error = pcall(function()
      Repair:FireServer(Battery, "Charge")
    end)
    if not OK then return false, tostring(Error) end
    if not WaitFor(function()
      return NumberAttr(Battery, "Damage") == 100
    end) then
      return false, "Battery did not reach 100"
    end
  end
  local OK, Error = pcall(function()
    InstallBattery:InvokeServer(Ctx.car, Battery, nil)
  end)
  if not OK then return false, tostring(Error) end
  if not WaitFor(function()
    return Find(Chassis, "Battery") ~= nil
      and (not GetLooseRoot() or not Battery:IsDescendantOf(GetLooseRoot()))
  end) then
    return false, "Battery reinstallation unconfirmed"
  end
  return true
end
local function BoxId(Box)
  return Box.Name:match("^Delivery_([%w%-]+)$")
end
local function BoxPosition(Box)
  if Box:IsA("BasePart") then return Box.Position end
  if Box:IsA("Model") then return Box:GetPivot().Position end
end
local function OpenBox(Box)
  local Id = BoxId(Box)
  if not Id then return false end
  if not InBoxes(Box) then return true end
  local Previous = OpenAttempts[Id]
  if Previous and os.clock() - Previous < CFG.BoxOpenRetry then
    return false
  end
  local PreviousPos, Stable = BoxPosition(Box), 0
  if not PreviousPos then return false end
  local Start, Stationary = os.clock(), false
  while InBoxes(Box) and os.clock() - Start < CFG.ActionTimeout do
    task.wait(0.2)
    local Position = BoxPosition(Box)
    if not Position then return false end
    Stable = (Position - PreviousPos).Magnitude <= 0.1 and Stable + 0.2 or 0
    if Stable >= CFG.BoxStableSeconds then Stationary = true break end
    PreviousPos = Position
  end
  if not Stationary then return false end
  OpenAttempts[Id] = os.clock()
  local OK, Response = pcall(function()
    return Open:InvokeServer(Id)
  end)
  if not OK or Response == false then
    return false
  end
  local Removed = WaitFor(function()
    return not InBoxes(Box)
  end, 8)
  if Removed then
    OpenedBoxes[Id] = os.clock()
    OpenAttempts[Id] = nil
  end
  return Removed
end
local function ExistingBoxes()
  local Boxes = GetBoxes()
  if not Boxes then return {} end

  local Found = {}

  for _, Box in ipairs(Boxes:GetChildren()) do
    if BoxId(Box) then
      table.insert(Found, Box)
    end
  end
  return Found
end
local function RecoverBoxes()
  local Boxes = GetBoxes()
  if not Boxes then return true, false end
  local Found = false
  for _, Entry in ipairs(PendingDeliveries:GetChildren()) do
    if tonumber(Entry.Name) then
      local Id = Entry:GetAttribute("Id")
      if typeof(Id) == "string" and Id ~= "" and not OpenedBoxes[Id] then
        local Box = Boxes:FindFirstChild("Delivery_" .. Id)
        if Box then
          Found = true
          if not OpenBox(Box) then return false, true end
        end
      end
    end
  end
  return true, Found
end
local function PendingEntryIds()
  local Ids = {}
  for _, Entry in ipairs(PendingDeliveries:GetChildren()) do
    if tonumber(Entry.Name) then
      local Id = Entry:GetAttribute("Id")
      if typeof(Id) == "string" and Id ~= "" then
        Ids[Id] = true
      end
    end
  end
  return Ids
end
local function AnyPendingEntries()
  for _, Entry in ipairs(PendingDeliveries:GetChildren()) do
    if tonumber(Entry.Name) then
      local Id = Entry:GetAttribute("Id")
      if typeof(Id) ~= "string" or not OpenedBoxes[Id] then
        return true
      end
    end
  end
  return false
end
local function Shortages(Ctx)
  local Stock = InventorySnapshot(Ctx.state.excluded)
  local Missing = {}
  for Name, Need in pairs(Ctx.state.required) do
    local Count = Stock[Name] and #Stock[Name] or 0
    local Deficit = math.max(0, Need - Count)
    if Deficit > 0 then Missing[Name] = Deficit end
  end
  return Missing
end
local function FindOrderBox(Purchase)
  local Boxes = GetBoxes()
  if not Boxes then return nil end

  if Purchase.box and InBoxes(Purchase.box) then
    return Purchase.box
  end
  local CurrentIds = PendingEntryIds()

  for Id in pairs(CurrentIds) do
    if not Purchase.beforePending[Id] then
      local Match = Boxes:FindFirstChild("Delivery_" .. Id)

      if Match then
        Purchase.deliveryId = Id
        Purchase.box = Match
        return Match
      end
    end
  end
  local New, Count = nil, 0

  for _, Box in ipairs(ExistingBoxes()) do
    if not Purchase.beforeBoxes[Box] then
      New = Box
      Count += 1
    end
  end
  if Count == 1 then
    Purchase.box = New
    Purchase.deliveryId = BoxId(New)
    return New
  end
  return nil
end
local function OrderHold(State, Message)
  State.orderReason = Message
  SetProgress(3, Message)
  return false
end
local function SettlePurchase(Ctx)
  local Purchase = Ctx.state.purchase
  if not Purchase then return true end

  local function ReceivedAll()
    local Stock = InventorySnapshot(Ctx.state.excluded)
    local Missing = {}
    for Name, Count in pairs(Purchase.submitted) do
      local Have = Stock[Name] and #Stock[Name] or 0
      if Have < (Purchase.beforeCounts[Name] or 0) + Count then
        table.insert(Missing, Name)
      end
    end
    return #Missing == 0, Missing
  end

  local Complete = ReceivedAll()
  if Complete then
    Ctx.state.purchase = nil
    return true
  end

  local Box = FindOrderBox(Purchase)
  if Box and not Purchase.opened then
    SetProgress(3, "Opening ordered parts...")
    if not OpenBox(Box) then
      return OrderHold(Ctx.state, "Waiting for ordered delivery box...")
    end
    Purchase.opened = true
    Purchase.deliveryId = BoxId(Box)
    Purchase.openedAt = os.clock()
  elseif not Box and Purchase.deliveryId and OpenedBoxes[Purchase.deliveryId] then
    Purchase.opened = true
    Purchase.openedAt = Purchase.openedAt or os.clock()
  end

  Complete = ReceivedAll()
  if Complete then
    Ctx.state.purchase = nil
    return true
  end

  if not Purchase.opened then
    if os.clock() - Purchase.startedAt >= CFG.DeliveryTimeout then
      return OrderHold(Ctx.state, "Delivery not detected; purchase held")
    end
    return OrderHold(Ctx.state, "Waiting for part delivery...")
  end

  local _, Missing = ReceivedAll()
  table.sort(Missing)
  if os.clock() - (Purchase.openedAt or os.clock()) >= CFG.ReceiptGrace then
    return OrderHold(Ctx.state, "Delivery short: " .. table.concat(Missing, ", "))
  end
  return OrderHold(Ctx.state, "Receiving: " .. table.concat(Missing, ", "))
end
local function OrderParts(Ctx)
  local State = Ctx.state
  State.orderReason = nil
  for _ = 1, CFG.MaxOrderRounds do
    local MissingInventory = MissingInventoryParts(Ctx.id)
    if #MissingInventory > 0 or PendingLooseUUIDs[Ctx.id] then
      local Ready, Recovered = WithdrawJobParts(Ctx.id, MissingInventory)
      if Recovered then State.pendingRecoveryReplan = true end
      if not Ready then return OrderHold(State, "Recovering customer inventory...") end
      return OrderHold(State, "Rechecking recovered customer parts...")
    end

    if State.purchase then
      if not SettlePurchase(Ctx) then return false end
    end
    if next(Shortages(Ctx)) == nil then return true end

    if State.orderRetryAt and os.clock() < State.orderRetryAt then
      return OrderHold(State, "Retrying rejected order...")
    end
    if AnyPendingEntries() then
      local Opened, HadBox = RecoverBoxes()
      if not Opened then
        return OrderHold(State, "Waiting for previous delivery box...")
      end
      if HadBox then
        local Until = os.clock() + 2
        repeat
          if next(Shortages(Ctx)) == nil then return true end
          task.wait(0.15)
        until os.clock() >= Until
      end
      if AnyPendingEntries() then
        return OrderHold(State, "Waiting for pending deliveries...")
      end
    end
    if ActiveJobs:FindFirstChild("1") ~= Ctx.job then return false end

    local Missing = Shortages(Ctx)
    local Payload, Submitted = {}, {}
    for Name, Count in pairs(Missing) do
      if (State.attempts[Name] or 0) >= CFG.MaxPurchasesPerPart then
        return OrderHold(State, "Order limit reached: " .. Name)
      end
      local Prefix, Suffix = EngineIds[Ctx.car.Name], StoreParts[Name]
      local Id = Prefix and Suffix and (Prefix .. "-" .. Suffix .. "-stock")
      if not Id then
        return OrderHold(State, "Unknown store item: " .. Name)
      end
      table.insert(Payload, {Id = Id, Class = "PartVariants", Count = Count})
      Submitted[Name] = Count
    end
    if #Payload == 0 then return true end
    table.sort(Payload, function(A, B) return A.Id < B.Id end)

    local BeforeBoxes = {}
    for _, Box in ipairs(ExistingBoxes()) do BeforeBoxes[Box] = true end
    local Stock, BeforeCounts = InventorySnapshot(State.excluded), {}
    for Name in pairs(Submitted) do
      BeforeCounts[Name] = Stock[Name] and #Stock[Name] or 0
    end

    if ActiveJobs:FindFirstChild("1") ~= Ctx.job then return false end
    local InventoryCheck = MissingInventoryParts(Ctx.id)
    if #InventoryCheck > 0 or PendingLooseUUIDs[Ctx.id] then
      local _, Recovered = WithdrawJobParts(Ctx.id, InventoryCheck)
      if Recovered then State.pendingRecoveryReplan = true end
      return OrderHold(State, "Recovering customer inventory...")
    end
    if AnyPendingEntries() then
      return OrderHold(State, "Waiting for pending deliveries...")
    end

    local Latest = Shortages(Ctx)
    if next(Latest) == nil then return true end
    local Changed = false
    for Name, Count in pairs(Submitted) do
      if Latest[Name] ~= Count then Changed = true break end
    end
    if Changed then return OrderHold(State, "Rechecking stock changes...") end

    State.purchase = {
      submitted = Submitted, beforeBoxes = BeforeBoxes,
      beforeCounts = BeforeCounts, beforePending = PendingEntryIds(),
      startedAt = os.clock(), opened = false
    }
    SetProgress(3, "Ordering " .. #Payload .. " part type(s)...")
    local OK, Response = pcall(function() return Order:InvokeServer(Payload) end)
    if not OK or Response == false then
      if not OK then
        return OrderHold(State, "Order response unclear; checking delivery...")
      end
      State.purchase = nil
      State.orderRetryAt = os.clock() + 3
      return OrderHold(State, "Order rejected; retrying...")
    end
    for Name in pairs(Submitted) do
      State.attempts[Name] = (State.attempts[Name] or 0) + 1
    end
    return SettlePurchase(Ctx)
  end
  return false
end
local function Assemble(Ctx)
  local Used = {}
  local Stock = InventorySnapshot(Ctx.state.excluded)
  for I = #Ctx.sequence, 1, -1 do
    local Name = Ctx.sequence[I]

    local Installed = Find(Ctx.engine, Name)
    if Installed then continue end

    local Candidates = Stock[Name] or {}
    local Part
    for _, Candidate in ipairs(Candidates) do
      if not Used[Candidate] then
        Part = Candidate
        break
      end
    end
    if not Part then
      SetProgress(4, "Missing ready part: " .. Name)
      return false
    end
    Used[Part] = true
    local OK, Result = pcall(function()
      return Install:InvokeServer(Ctx.car, Part, nil)
    end)
    if not OK or Result == false or not WaitFor(function()
      local Root = GetLooseRoot()
      return Find(Ctx.engine, Name) ~= nil
        and (not Root or not Part:IsDescendantOf(Root))
    end) then
      SetProgress(4, "Installation not confirmed: " .. Name)
      return false
    end
    task.wait(CFG.ActionGap)
  end
  return true
end
local function CompleteJob(Ctx)
  SetProgress(5, "Completing customer job...")
  if not WaitFor(function() return AllTasksDone(Ctx.job) end) then
    return false
  end
  task.wait(CFG.FinishDelay)
  if ActiveJobs:FindFirstChild("1") ~= Ctx.job then
    return false
  end
  local State = Ctx.state
  if not State.completionSent then
    State.completionSent = true
    local OK, Result = pcall(function()
      return Complete:InvokeServer(Ctx.id)
    end)
    if not OK or Result == false then
      return false
    end
  end
  local Finished = WaitFor(function()
    return ActiveJobs:FindFirstChild("1") ~= Ctx.job
  end)
  if Finished then
    JobStates[Ctx.id] = nil
    SetProgress(6, "Customer job completed!")
  end
  return Finished
end
local function ProcessJob(Job, Car, Id)
  SetProgress(1, "Preparing customer job...")
  if IsInspectionJob(Job) then return false end
  local State = JobStates[Id]
  if not State then
    State = {
      attempts = {}, remoteSent = {}, originallyDetached = {},
      excluded = {}, required = {}, repairList = {},
      problems = {}, statuses = {}, purchase = nil,
      planned = false, cleanDone = false, batteryDone = false,
      engineDone = false, completionSent = false
    }
    JobStates[Id] = State
  end
  if State.engineDone or AllTasksDone(Job) then
    return CompleteJob({job=Job, id=Id, state=State})
  end
  if not Car then
    return false
  end
  if not EngineIds[Car.Name] then
    return false
  end
  local Folder = Job:FindFirstChild("Tasks")
  if not Folder then return false end
  local Tasks = {required = {}, targets = {}, battery = false}
  for _, Task in ipairs(Folder:GetChildren()) do
    if tonumber(Task.Name) and not TaskDone(Task) then
      local Target = Normalize(Task:GetAttribute("Target"))
      if Target == "battery" then
        Tasks.battery = true
      else
        local Name = ResolveNames[Target]
        if Name then Tasks.targets[Name] = true end
        if Task:GetAttribute("IsScrapped") == true
          or (Task:GetAttribute("Type") == "InstallEngineComponent"
            and Normalize(Task:GetAttribute("RequiredValue")) == "stock") then
          if not Name then return false end
          Tasks.required[Name] = 1
        end
      end
    end
  end

  if not next(Tasks.targets) and not next(Tasks.required) then
    if Tasks.battery then
      local Missing = MissingInventoryParts(Id)
      if #LooseCandidates("Battery") == 0 and (#Missing > 0 or PendingLooseUUIDs[Id]) then
        local Ready = WithdrawJobParts(Id, Missing)
        if not Ready then return false, "recovery" end
      end
      SetProgress(3, "Charging battery...")
      local BatteryCtx = {job=Job, id=Id, car=Car, state=State}
      if not State.batteryDone then
        local OK, Reason = ServiceBattery(BatteryCtx)
        if not OK then   return false end
        State.batteryDone = true
      end
      State.engineDone = true
      return CompleteJob(BatteryCtx)
    end
    return false
  end
  local Engine = Find(Car:FindFirstChild("Misc"), "Engine")
  if not Engine then   return false end
  local Ctx = {
    job = Job, id = Id, car = Car, engine = Engine,
    tasks = Tasks, state = State
  }

  if not State.sequence then
    State.sequence = {}
    local Intercooler = Find(Engine, "Intercooler") ~= nil
      or Tasks.targets.Intercooler or Tasks.required.Intercooler ~= nil
    for _, Name in ipairs(EngineOrder) do
      if Name ~= "Intercooler" or Intercooler then
        table.insert(State.sequence, Name)
      end
    end
  end
  Ctx.sequence = State.sequence

  local Missing = MissingInventoryParts(Id)
  if #Missing > 0 or PendingLooseUUIDs[Id] then
    local Ready, Recovered = WithdrawJobParts(Id, Missing)
    if not Ready then return false, "recovery" end
    if Recovered and State.planned then ResetRecoveredPlan(State) end
  end
  if not State.planned then
    SetProgress(2, "Disassembling engine...")
    Disassemble(Ctx)
    BuildPlan(Ctx)
    State.planned = true
  end
  SetProgress(3, "Cleaning / Ordering parts...")
  local CleanOK, OrderOK, BatteryOK = State.cleanDone, false,
    (not Tasks.battery) or State.batteryDone
  local CleanFinished = CleanOK
  local OrderFinished = false
  local BatteryFinished = BatteryOK

  task.spawn(function()
    local OK, Result = pcall(OrderParts, Ctx)
    OrderOK = OK and Result == true
    OrderFinished = true
  end)
  if not State.cleanDone then
    task.spawn(function()
      local OK, Result = pcall(CleanEngine, Ctx)
      CleanOK = OK and Result == true
      State.cleanDone = CleanOK
      CleanFinished = true
    end)
  end
  if not BatteryFinished then
    task.spawn(function()
      local OK, Result = pcall(ServiceBattery, Ctx)
      BatteryOK = OK and Result == true
      State.batteryDone = BatteryOK
      BatteryFinished = true
    end)
  end
  while not (CleanFinished and OrderFinished and BatteryFinished) do
    task.wait(0.1)
  end
  if State.pendingRecoveryReplan then
    State.pendingRecoveryReplan = nil
    ResetRecoveredPlan(State)
    SetProgress(1, "Rechecking recovered customer parts...")
    return false, "recovery"
  end
  for Name, Reason in pairs(State.problems) do
    return false, Name .. ": " .. Reason
  end
  if not CleanOK then return false, "Cleaning incomplete" end
  if not OrderOK then
    if #MissingInventoryParts(Id) > 0 or PendingLooseUUIDs[Id] then
      SetProgress(3, "Recovering inventory before ordering...")
      return false, "recovery"
    end
    return false, State.orderReason or "Ordering or stock check incomplete"
  end
  if not BatteryOK then return false, "Battery service incomplete" end

  if not State.engineDone then
    SetProgress(4, "Reassembling engine...")
    if not Assemble(Ctx) then return false, "Reassembly incomplete" end
    State.engineDone = true
  end
  return CompleteJob(Ctx)
end
local function DelayWhileOn(Seconds)
  local EndAt = os.clock() + Seconds
  while os.clock() < EndAt do
    if not enabled then
      return false
    end
    task.wait(0.1)
  end
  return true
end
AutoLoop = function()
  local LastClaimId, LastClaimAt
  while enabled do
    local Job = ActiveJobs:FindFirstChild("1")
    local Id = Job and Job:GetAttribute("Id")
    if typeof(Id) ~= "string" or Id == "" then Job = nil end
    local Car
    if Job then
      for _, Candidate in ipairs(Cars:GetChildren()) do
        if tostring(Candidate:GetAttribute("CustomerJobId")) == Id then
          Car = Candidate
          break
        end
      end
    end
    if not Job and (JunkyardBusy or Player:GetAttribute("InShopInterior") == false) then
      task.wait(0.2)
    elseif Job then
      local RetryDelay = 1.25
      if IsInspectionJob(Job) then
        SetProgress(1, "Skipping vehicle inspection...")
        IgnoredInspections[Id] = true
        local OK, Result = pcall(function() return Cancel:InvokeServer(Id) end)
        if OK and Result ~= false then
          WaitFor(function() return ActiveJobs:FindFirstChild("1") ~= Job end)
          RetryDelay = CFG.ClaimInterval
        end
      else
        local OK, Result, Reason = pcall(ProcessJob, Job, Car, Id)
        if not OK then
          SetProgress(currentStep, "Job error - retrying...")
        elseif Result == true then
          RetryDelay = CFG.BetweenJobs
        elseif Result ~= true and Reason == "recovery" then
          RetryDelay = 0.35
        elseif Result ~= true then
          if Reason then SetProgress(currentStep, Reason)
          elseif currentStep ~= 4 then
            SetProgress(currentStep, "Job incomplete - retrying...")
          end
        end
      end
      if not DelayWhileOn(RetryDelay) then break end
    else
      SetProgress(0, "Searching for customer jobs...")
      local OfferId, BestPay = nil, -math.huge
      for _, Offer in ipairs(Offers:GetChildren()) do
        if tonumber(Offer.Name) then
          local Id, Pay = Offer:GetAttribute("Id"), Offer:GetAttribute("Payment")
          local Type = Normalize(Offer:GetAttribute("Type"))
          if typeof(Id) == "string" and Id ~= ""
            and typeof(Pay) == "number" and Pay > BestPay
            and not IgnoredInspections[Id]
            and Type ~= "vehicleinspection" and Type ~= "inspectvehicle" then
            OfferId, BestPay = Id, Pay
          end
        end
      end
      if OfferId and not JunkyardBusy
        and Player:GetAttribute("InShopInterior") ~= false
        and (OfferId ~= LastClaimId or os.clock() - (LastClaimAt or 0) >= 0.8) then
        LastClaimId, LastClaimAt = OfferId, os.clock()
        SetProgress(1, "Claiming customer job...")
        pcall(function() return Accept:InvokeServer(OfferId) end)
      end
      if not DelayWhileOn(CFG.ClaimInterval) then break end
    end
  end
  running = false
  SetProgress(0, "Paused")
end
