  ScanQueued = true
  task.spawn(function()
    task.wait(0.5)
    if JunkyardEnabled and not AutoHopEnabled and not JunkyardBusy then
      pcall(ScanJunkyard, false)
    end
    ScanQueued = false
  end)
end
local function RefreshSeconds()
  local Interactions = workspace:FindFirstChild("__INTERACTIONS")
  local Panel = Interactions and Interactions:FindFirstChild("RefreshingPanel")
  if not Panel then return nil end
  local Children = Panel:GetChildren()
  local function Read(Child)
    local Board = Child:FindFirstChild("RefreshBoard")
    local Rim = Board and Board:FindFirstChild("Rim")
    local Bg = Rim and Rim:FindFirstChild("Bg")
    local Timer = Bg and Bg:FindFirstChild("Timer")
    local Time = Timer and Timer:FindFirstChild("Time")
    if not Time then return nil end
    local Raw
    if Time:IsA("TextLabel") or Time:IsA("TextButton") then
      Raw = Time.Text
    elseif Time:IsA("StringValue") then
      Raw = Time.Value
    end
    if typeof(Raw) ~= "string" then return nil end
    local Minutes, Seconds = Raw:match("^%s*(%d+):(%d+)%s*$")
    if Minutes and Seconds then
      return tonumber(Minutes) * 60 + tonumber(Seconds)
    end
    local Single = Raw:match("^%s*(%d+)%s*$")
    return Single and tonumber(Single) or nil
  end
  if Children[7] then
    local Result = Read(Children[7])
    if Result then return Result end
  end
  for _, Child in ipairs(Children) do
    local Result = Read(Child)
    if Result then return Result end
  end
end
local function WaitForNextRotation(Seconds)
  local Previous = JunkyardRotation
  local Deadline = os.clock() + Seconds + 12
  while AutoHopEnabled and JunkyardEnabled and AutoLoadName ~= nil and os.clock() < Deadline do
    if JunkyardRotation > Previous then
      task.wait(1)
      return true
    end
    local Remaining = RefreshSeconds()
    if Remaining and Remaining > Seconds + 5 then
      task.wait(1)
      return true
    end
    task.wait(0.2)
  end
  return false
end
local function QueueNextServer()
  local Queue = queue_on_teleport
    or (syn and syn.queue_on_teleport)
    or (fluxus and fluxus.queue_on_teleport)
  if typeof(Queue) ~= "function" then return false end
  if WAYFINDER_RAW_URL == "YOUR_WAYFINDER_RAW_URL" then return false end
  local TeleportService = game:GetService("TeleportService")
  local URL = "https://games.roblox.com/v1/games/" .. game.PlaceId
    .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"
  local OK, Data = pcall(function()
    return HTTP:JSONDecode(game:HttpGet(URL))
  end)
  if not OK or typeof(Data) ~= "table" then return false end
  local Available = {}
  for _, Server in ipairs(Data.data or {}) do
    if typeof(Server.id) == "string" and Server.id ~= game.JobId
      and typeof(Server.playing) == "number"
      and typeof(Server.maxPlayers) == "number"
      and Server.playing < Server.maxPlayers
      and not VisitedServers[Server.id] then
      table.insert(Available, Server.id)
    end
  end
  if #Available == 0 then return false end
  local Target = Available[math.random(#Available)]
  VisitedServers[game.JobId] = true
  VisitedServers[Target] = true
  if Session.__WayfinderQueuedServer ~= game.JobId then
    local Loader = string.format([[
      if not game:IsLoaded() then game.Loaded:Wait() end
      local Env = (getgenv and getgenv()) or _G
      if Env.__WayfinderLoaderServer == game.JobId
        or Env.__WayfinderActiveServer == game.JobId then return end
      Env.__WayfinderLoaderServer = game.JobId
      Env.__WayfinderHopResume = game:GetService("HttpService"):JSONDecode(%q)
      local OK = pcall(function() loadstring(game:HttpGet(%q))() end)
      if not OK then Env.__WayfinderLoaderServer = nil end
    ]], HTTP:JSONEncode({enabled = true, targets = SelectedVehicles, visited = VisitedServers}), WAYFINDER_RAW_URL)
    if not pcall(Queue, Loader) then return false end
    Session.__WayfinderQueuedServer = game.JobId
  end

  local Failed = false
  local FailureConnection = TeleportService.TeleportInitFailed:Connect(function(FailedPlayer, _, _, FailedPlaceId, Options)
    if FailedPlayer ~= Player or FailedPlaceId ~= game.PlaceId then return end
    if Options and Options.ServerInstanceId and Options.ServerInstanceId ~= Target then return end
    Failed = true
  end)
  local Started = pcall(function()
    TeleportService:TeleportToPlaceInstance(game.PlaceId, Target, Player)
  end)
  if not Started then Failed = true end
  local Deadline = os.clock() + 25
  while not Failed and os.clock() < Deadline do
    if not AutoHopEnabled or not JunkyardEnabled
      or SnipeSucceeded or SnipeUncertain then break end
    task.wait(0.2)
  end
  FailureConnection:Disconnect()
  return false
end
StartAutoHop = function()
  if AutoHopRunning or not AutoHopEnabled or not JunkyardEnabled then return end
  if not HasAutoLoadConfig() then
    AutoHopEnabled = false
    if AutoHopToggle then AutoHopToggle:Set(false, true) end
    return
  end
  if #SelectedVehicles == 0 then
    pcall(function()
      Window:Notify({title = "No targets selected", content = "Choose a vehicle before auto serverhopping.", duration = 5})
    end)
    return
  end
  AutoHopRunning = true
  task.spawn(function()
    pcall(function()
      if Player:GetAttribute("OnLoadingScreen") ~= false then
        local Gui = Player:WaitForChild("PlayerGui")
        local Deadline = os.clock() + 45
        while os.clock() < Deadline do
          local Menu = Gui:FindFirstChild("MenuScreen")
          local Container = Menu and Menu:FindFirstChild("Container")
          local Play = Container and Container:FindFirstChild("PlayBtn")
          if Play and Play.Visible then
            pcall(function() FinishLoading:FireServer("Finished") end)
            break
          end
          if Player:GetAttribute("OnLoadingScreen") == false then break end
          task.wait(0.2)
        end
        local Final = os.clock() + 35
        while Player:GetAttribute("OnLoadingScreen") ~= false and os.clock() < Final do
          task.wait(0.2)
        end
        if Player:GetAttribute("OnLoadingScreen") ~= false then return end
      end
      task.wait(2)
      while AutoHopEnabled and JunkyardEnabled and AutoLoadName ~= nil and #SelectedVehicles > 0
        and not SnipeSucceeded and not SnipeUncertain do
        while JunkyardBusy and AutoHopEnabled and JunkyardEnabled do
          task.wait(0.2)
        end
        if not AutoHopEnabled or not JunkyardEnabled then break end
        ScanJunkyard(true)
        if SnipeSucceeded or SnipeUncertain then break end

        local Remaining = RefreshSeconds()
        if Remaining and Remaining < 20 then
          if WaitForNextRotation(Remaining) then
            if not AutoHopEnabled or not JunkyardEnabled then break end
            ScanJunkyard(true)
            if SnipeSucceeded or SnipeUncertain then break end
          end
        end
        pcall(function()
          Window:Notify({
            title = "No Snipes",
            content = "Server hopping in 5 seconds",
            icon = 92188766517878,
            duration = 5
          })
        end)
        local Deadline = os.clock() + 5
        while os.clock() < Deadline do
          if not AutoHopEnabled or not JunkyardEnabled then break end
          if SnipeSucceeded or SnipeUncertain then break end
          task.wait(0.1)
        end
        if not AutoHopEnabled or not JunkyardEnabled
          or SnipeSucceeded or SnipeUncertain then break end
        local NextRefresh = RefreshSeconds()
        if NextRefresh and NextRefresh < 20 then
          if WaitForNextRotation(NextRefresh) then
            ScanJunkyard(true)
            if SnipeSucceeded or SnipeUncertain then break end
          end
        end
        if not AutoHopEnabled or not JunkyardEnabled or #SelectedVehicles == 0 then break end
        QueueNextServer()
        task.wait(5)
      end
    end)
    AutoHopRunning = false
  end)
end
