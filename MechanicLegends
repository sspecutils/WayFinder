local function GetOwnedVehicles()
  local Folder = Reflect:FindFirstChild("Inventory")
  local Entries = {}
  if not Folder then return Entries end
  for _, Entry in ipairs(Folder:GetChildren()) do
    if Entry:GetAttribute("Class") == "Vehicles" then
      local Uuid = Entry:GetAttribute("UUID") or Entry:GetAttribute("Uuid")
      if typeof(Uuid) == "string" and Uuid ~= "" then
        local Metadata = Entry:FindFirstChild("Metadata")
        local Id = Entry:GetAttribute("ItemID") or (Metadata and Metadata:GetAttribute("ItemID"))
          or Entry:GetAttribute("ItemId") or (Metadata and Metadata:GetAttribute("ItemId"))
          or Entry:GetAttribute("DirId") or (Metadata and Metadata:GetAttribute("DirId"))
        table.insert(Entries, {
          uuid = Uuid, id = Id, entry = Entry,
          name = Id and tostring(Id) ~= "" and tostring(Id) or ("Vehicle " .. Entry.Name)
        })
      end
    end
  end
  table.sort(Entries, function(A, B)
    local AKey, BKey = A.name, B.name
    if AKey == BKey then return A.uuid < B.uuid end
    return AKey < BKey
  end)
  return Entries
end
local function OwnedCarColorName(Entry)
  local Metadata = Entry:FindFirstChild("Metadata")
  local PaintSlots = Metadata and Metadata:FindFirstChild("PaintSlots")
  local Primary = PaintSlots and PaintSlots:FindFirstChild("Primary")
  local Color = Primary and Primary:FindFirstChild("Color")
  if not Color then return "Unknown" end
  local function Channel(Key)
    local Value = Color:GetAttribute(Key)
    if typeof(Value) == "string" then
      return tonumber(Value, 16)
    elseif typeof(Value) == "number" then
      return Value
    end
    return nil
  end
  local R, G, B = Channel("1"), Channel("2"), Channel("3")
  if not (R and G and B) then return "Unknown" end
  R, G, B = math.clamp(R, 0, 255), math.clamp(G, 0, 255), math.clamp(B, 0, 255)
  local Max, Min = math.max(R, G, B), math.min(R, G, B)
  local Delta = Max - Min
  if Max <= 40 then return "Black" end
  if Min >= 224 then return "White" end
  if Delta <= 22 then
    if Max <= 95 then return "Dark Gray" end
    if Max >= 190 then return "Silver" end
    return "Gray"
  end
  local H
  if Max == R then H = (G - B) / Delta % 6
  elseif Max == G then H = (B - R) / Delta + 2
  else H = (R - G) / Delta + 4 end
  H *= 60
  if Max < 110 and Min < 55 and H >= 15 and H < 55 then return "Brown" end
  if H < 15 or H >= 345 then return "Red" end
  if H < 45 then return "Orange" end
  if H < 70 then return "Yellow" end
  if H < 165 then return "Green" end
  if H < 195 then return "Cyan" end
  if H < 255 then return "Blue" end
  if H < 290 then return "Purple" end
  if H < 345 then return "Pink" end
  return "Red"
end
local function RefreshOwnedCars()
  local Previous = SelectedCarUuid
  local Items = GetOwnedVehicles()
  local Options, UsedLabels = {}, {}
  CarLabelToUuid = {}
  local SelectedLabel
  for _, Item in ipairs(Items) do
    local Base = Item.name .. " (" .. OwnedCarColorName(Item.entry) .. ")"
    local Label = Base
    if UsedLabels[Label] then
      local Tail = Item.uuid:sub(1, 4)
      Label = Base .. " " .. Tail
      local Counter = 2
      while UsedLabels[Label] do
        Label = Base .. " " .. Tail .. "-" .. Counter
        Counter += 1
      end
    end
    UsedLabels[Label] = true
    CarLabelToUuid[Label] = Item.uuid
    table.insert(Options, Label)
    if Item.uuid == Previous then SelectedLabel = Label end
  end
  OwnedCarDropdown:Refresh(Options)
  SelectedCarUuid = SelectedLabel and Previous or nil
  if SelectedLabel then OwnedCarDropdown:Set(SelectedLabel) end
end

