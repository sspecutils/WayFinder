local function ResolvePaintCar(Owned)
  for _, Car in ipairs(Cars:GetChildren()) do
    if Car:GetAttribute("ItemUUID") == Owned.uuid
      or Car:GetAttribute("UUID") == Owned.uuid
      or Car:GetAttribute("Uuid") == Owned.uuid
      or Car:GetAttribute("InventoryUUID") == Owned.uuid then
      return Car
    end
  end

  local Before = {}
  for _, Car in ipairs(Cars:GetChildren()) do Before[Car] = true end
  local Success, Response = pcall(function()
    return F:WaitForChild("RequestSpawnVehicle"):InvokeServer(Owned.uuid)
  end)
  if not Success or Response == false then
    error("Couldn't spawn the selected vehicle: " .. tostring(Response))
  end
  if typeof(Response) == "Instance" and Response:IsA("Model") then
    return Response
  end
  local Deadline = os.clock() + 12
  repeat
    for _, Car in ipairs(Cars:GetChildren()) do
      if Car:GetAttribute("ItemUUID") == Owned.uuid
        or Car:GetAttribute("UUID") == Owned.uuid
        or Car:GetAttribute("Uuid") == Owned.uuid
        or Car:GetAttribute("InventoryUUID") == Owned.uuid then
        return Car
      end
    end
    local Candidate, Count = nil, 0
    for _, Car in ipairs(Cars:GetChildren()) do
      if not Before[Car] and (not Owned.id or Car.Name == Owned.id) then
        Candidate, Count = Car, Count + 1
      end
    end
    if Count == 1 then return Candidate end
    task.wait(0.2)
  until os.clock() > Deadline
  error("Couldn't identify the selected spawned vehicle.")
end

local PaintLocations = {
  Prep = Vector3.new(373, 4, 4736),
  Paint = Vector3.new(396, 4, 4732)
}

local function TeleportForPaint(Car, Destination)
  if not Car:IsA("Model") or not Car.Parent then
    error("Selected vehicle is not available to teleport.")
  end

  local Character = Player.Character
  local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
  if not Humanoid then error("Your character must be spawned before painting.") end

  local Seat
  local Deadline = os.clock() + 8
  repeat
    Seat = Humanoid.SeatPart
    if Seat and Seat:IsA("BasePart") and Seat:IsDescendantOf(Car) then break end
    task.wait(0.1)
  until os.clock() >= Deadline
  if not Seat or not Seat:IsDescendantOf(Car) then
    error("You must be seated in the selected car to teleport it.")
  end

  local RootPart = Seat.AssemblyRootPart or Seat
  if RootPart.Anchored then
    error("The selected vehicle is anchored and cannot be vehicle-teleported.")
  end
  local Target = typeof(Destination) == "CFrame"
    and Destination or CFrame.new(Destination) * Car:GetPivot().Rotation
  local Delta = Target * Car:GetPivot():Inverse()
  local Assemblies = {}
  for _, Part in ipairs(Car:GetDescendants()) do
    if Part:IsA("BasePart") and not Part.Anchored then
      local Root = Part.AssemblyRootPart or Part
      Assemblies[Root] = true
    end
  end
  Assemblies[RootPart] = true

  for Part in pairs(Assemblies) do
    Part.CFrame = Delta * Part.CFrame
    Part.AssemblyLinearVelocity = Vector3.zero
    Part.AssemblyAngularVelocity = Vector3.zero
  end
  task.wait()
  if Humanoid.SeatPart ~= Seat then
    error("The vehicle teleport unseated you; paint request cancelled.")
  end
end

local function ReadOwnedPrimaryPaint(Owned)
  local Meta = Owned.entry and Owned.entry:FindFirstChild("Metadata")
  local Slots = Meta and Meta:FindFirstChild("PaintSlots")
  local Slot = Slots and Slots:FindFirstChild("Primary")
  local Color = Slot and Slot:FindFirstChild("Color")
  if not Color then return nil end
  local Values = {}
  for I = 1, 3 do
    local V = Color:GetAttribute(tostring(I))
    if typeof(V) == "string" then
      V = tonumber(V, 16)
    end
    if typeof(V) ~= "number" then return nil end
    Values[I] = math.clamp(V, 0, 255)
  end
  return Color3.fromRGB(Values[1], Values[2], Values[3])
end

local function PaintMatches(A, B)
  return typeof(A) == "Color3" and typeof(B) == "Color3"
    and math.abs(A.R - B.R) <= 1 / 255 + 0.0001
    and math.abs(A.G - B.G) <= 1 / 255 + 0.0001
    and math.abs(A.B - B.B) <= 1 / 255 + 0.0001
end

local function WaitForPaintUpdate(Owned, TargetColor, Previous, Timeout)
  local Deadline = os.clock() + Timeout
  repeat
    local Current = ReadOwnedPrimaryPaint(Owned)
    if PaintMatches(Current, TargetColor) then return true end
    task.wait(0.15)
  until os.clock() >= Deadline
  return false
end

local function RunPaintAction(Action)
  if PaintActionBusy or ManualBusy then
    PaintNotice("Vehicle busy", "Another vehicle maintenance action is running.")
    return
  end
  if Player:GetAttribute("InShopInterior") ~= false then
    PaintNotice("Outside workshop only", "Leave your workshop before using vehicle painting.")
    return
  end
  if enabled or running then
    PaintNotice("Customer Jobs running", "Disable Customer Jobs before painting a car.")
    return
  end
  PaintActionBusy = true
  task.spawn(function()
    local Car, OriginalPivot, Moved
    local Success, Error = pcall(function()
      local Owned = FindSelectedOwnedCar()
      Car = ResolvePaintCar(Owned)
      if Player:GetAttribute("InShopInterior") ~= false then
        error("Leave your workshop before using vehicle painting.")
      end
      task.wait(1)
      if not Car.Parent then error("The selected vehicle despawned.") end
      OriginalPivot = Car:GetPivot()
      TeleportForPaint(Car, PaintLocations[Action])
      Moved = true
      task.wait(1)
      if not Car.Parent then error("The selected vehicle despawned.") end

      if Action == "Prep" then
        if Car:GetAttribute("PaintRusted") ~= true then
          PaintNotice("Paint ready", "The selected car already has no paint rust.")
          return
        end
        local Result = F:WaitForChild("PaintShopPrep"):InvokeServer(Car)
        if Result == false then error("The game rejected the rust removal request.") end
        if not WaitFor(function()
          return Car:GetAttribute("PaintRusted") ~= true
        end, 12) then
          error("Rust removal was not confirmed within 12 seconds.")
        end
        PaintNotice("Rust removed", "Paint rust removed; returning to original position.")
      else
        if Car:GetAttribute("PaintRusted") == true then
          error("Remove paint rust first (PaintRusted is true).")
        end
        local WantedColor = SelectedPaintColor
        local BeforeColor = ReadOwnedPrimaryPaint(Owned)
        local Result = F:WaitForChild("PaintShopSetPaint"):InvokeServer(
          Car, "Exterior", "Primary", WantedColor
        )
        if Result == false then error("The game rejected the paint request.") end
        if not PaintMatches(BeforeColor, WantedColor) then
          if not WaitForPaintUpdate(Owned, WantedColor, BeforeColor, 12) then
            error("Paint colour change was not confirmed within 12 seconds.")
          end
        end
        PaintNotice("Paint applied", "Colour updated; returning to original position.")
        task.defer(RefreshOwnedCars)
      end
    end)

    if Moved and Car and Car.Parent and OriginalPivot then
      local BackOK, BackError = pcall(function()
        TeleportForPaint(Car, OriginalPivot)
      end)
      if not BackOK then
        PaintNotice("Return teleport failed", tostring(BackError):gsub("^.-:%d+: ", ""))
      end
    end
    if not Success then
      PaintNotice("Painting failed", tostring(Error):gsub("^.-:%d+: ", ""))
    end
    PaintActionBusy = false
  end)
end

