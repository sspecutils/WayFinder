local function MissingInventoryParts(Id)
  local Visible = VisibleLooseUUIDs()
  local Missing = {}
  local Inventory = Reflect:FindFirstChild("Inventory")
  if Inventory then
    for _, Entry in ipairs(Inventory:GetChildren()) do
      if tonumber(Entry.Name) then
        local Metadata, UUID = Entry:FindFirstChild("Metadata"), Entry:GetAttribute("UUID")
        if Metadata and tostring(Metadata:GetAttribute("CustomerJobId")) == tostring(Id)
          and typeof(UUID) == "string" and UUID ~= "" and not Visible[UUID] then
          table.insert(Missing, {uuid = UUID})
        end
      end
    end
  end
  local Pending = PendingLooseUUIDs[Id]
  if Pending then
    for UUID in pairs(Pending) do
      if Visible[UUID] then Pending[UUID] = nil end
    end
    if next(Pending) == nil then PendingLooseUUIDs[Id] = nil end
  end
  return Missing, Visible
end
local function WithdrawJobParts(Id, Missing)
  Missing = Missing or MissingInventoryParts(Id)
  if #Missing == 0 and not PendingLooseUUIDs[Id] then return true, false end

  local Pending = PendingLooseUUIDs[Id] or {}
  PendingLooseUUIDs[Id] = Pending
  local Sent = WithdrawCooldowns[Id] or {}
  WithdrawCooldowns[Id] = Sent
  local Now = os.clock()

  for _, Part in ipairs(Missing) do
    Pending[Part.uuid] = true
    if not Sent[Part.uuid] or Now - Sent[Part.uuid] >= 3 then
      Sent[Part.uuid] = Now
      task.spawn(function()
        pcall(function() WithdrawPart:InvokeServer(Part.uuid) end)
      end)
    end
  end
  local Deadline = os.clock() + 8
  repeat
    local Visible = VisibleLooseUUIDs()
    local Remaining = 0
    for UUID in pairs(Pending) do
      if Visible[UUID] then
        Pending[UUID] = nil
      else
        Remaining += 1
      end
    end
    if Remaining == 0 then
      PendingLooseUUIDs[Id] = nil
      SetProgress(1, "Customer parts recovered")
      return true, true
    end
    SetProgress(1, "Waiting for " .. Remaining .. " withdrawn parts...")
    task.wait(0.2)
  until os.clock() >= Deadline
  return false, true
end
