local function ResolveMaintenanceCar(Selected)
  local Uuid = Selected.uuid
  local Car = FindSpawnedCar(Uuid, Selected.id, {})
  if Car then
    local FoundUuid = Car:GetAttribute("ItemUUID") or Car:GetAttribute("UUID")
      or Car:GetAttribute("Uuid") or Car:GetAttribute("InventoryUUID")
    if FoundUuid ~= Uuid then Car = nil end
  end
  if not Car then
    local Before = {}
    for _, Existing in ipairs(Cars:GetChildren()) do Before[Existing] = true end
    local OK, Response = pcall(function()
      return F:WaitForChild("RequestSpawnVehicle"):InvokeServer(Uuid)
    end)
    if not OK or Response == false then
      error("Could not spawn the selected car in the workshop.")
    end
    if typeof(Response) == "Instance" and Response:IsA("Model") then Car = Response end
    local Deadline = os.clock() + 15
    while not Car and os.clock() < Deadline do
      Car = FindSpawnedCar(Uuid, Selected.id, Before)
      if not Car then task.wait(0.2) end
    end
  end
  if not Car or not Car.Parent then error("Selected car was not found after spawning.") end
  local Engine = Find(Car:FindFirstChild("Misc"), "Engine")
  if not Engine then error("The selected car has no Engine folder.") end
