MiscTab:CreateButton({
  name = "Server Hop",
  icon = 103768533135201,
  callback = function()
    task.spawn(function()
      local HttpService = game:GetService("HttpService")
      local TeleportService = game:GetService("TeleportService")

      local URL = "https://games.roblox.com/v1/games/" .. game.PlaceId
        .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"

      local Success, Servers = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(URL)).data
      end)
      if not Success or not Servers then return end

      local Available = {}

      for _, Server in ipairs(Servers) do
        if Server.id ~= game.JobId
          and Server.playing < Server.maxPlayers then
          table.insert(Available, Server.id)
        end
      end
      if #Available == 0 then return end

      local Target = Available[math.random(#Available)]
      pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, Target, Player)
      end)
    end)
  end
})
