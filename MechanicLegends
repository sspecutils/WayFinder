local function ExpectedEngineParts(CarId, Engine)
  local Result = {}
  local Directory = RS:FindFirstChild("__DIRECTORY")
  local Engines = Directory and Directory:FindFirstChild("Engines")
  local Vehicles = Directory and Directory:FindFirstChild("Vehicles")
  local VehicleModule = Vehicles and Vehicles:FindFirstChild(CarId)
  if VehicleModule and Engines then
    local OK, Data = pcall(require, VehicleModule)
    if OK and typeof(Data) == "table" then
      local EngineId = Data.DefaultEngineId
      if not EngineId then
        for _, Key in ipairs({"Data", "Config", "Properties"}) do
          local Inner = Data[Key]
          if typeof(Inner) == "table" and Inner.DefaultEngineId then
            EngineId = Inner.DefaultEngineId
            break
          end
        end
      end
      local EngineModule = typeof(EngineId) == "string" and Engines:FindFirstChild(EngineId)
      if EngineModule then
        local Good, EngineData = pcall(require, EngineModule)
        if Good and typeof(EngineData) == "table" then
          local Slots = EngineData.Slots
          if typeof(Slots) == "table" then
            local function Walk(Obj, Depth)
              if Depth > 3 then return end
              for Key, Value in pairs(Obj) do
                local Name = ResolveNames[Normalize(Key)]
                if Name then Result[Name] = true end
                if typeof(Value) == "string" then
                  Name = ResolveNames[Normalize(Value)]
                  if Name then Result[Name] = true end
                elseif typeof(Value) == "table" then
                  Walk(Value, Depth + 1)
                end
              end
            end
            Walk(Slots, 1)
          end
        end
      end
    end
  end
  for _, Name in ipairs(EngineOrder) do
    if Find(Engine, Name) then Result[Name] = true end
  end
  if not Find(Engine, "Intercooler") then Result.Intercooler = nil end
  return Result
end
RepairOwnedCar = function()
  if ManualBusy then return end
  if Player:GetAttribute("InShopInterior") ~= true then
    Window:Notify({title = "Workshop required", content = "Fix Selected Car only works inside your workshop.", duration = 5})
    return
  end
