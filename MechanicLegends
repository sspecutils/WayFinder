local EngineIds = setmetatable({}, {
  __index = function(Cache, CarName)
    local Directory = RS:FindFirstChild("__DIRECTORY")
    local Vehicles = Directory and Directory:FindFirstChild("Vehicles")
    local Engines = Directory and Directory:FindFirstChild("Engines")
    local Vehicle = Vehicles and Vehicles:FindFirstChild(CarName)
    if not Vehicle or not Vehicle:IsA("ModuleScript") or not Engines then return nil end
    local OK, Entry = pcall(require, Vehicle)
    if not OK or typeof(Entry) ~= "table" then return nil end
    local Info = Entry
    for _, Key in ipairs({"Data", "Config", "Properties"}) do
      if typeof(Entry[Key]) == "table" and typeof(Entry[Key].DefaultEngineId) == "string" then
        Info = Entry[Key]
        break
      end
    end
    local EngineId = Info.DefaultEngineId
    if typeof(EngineId) ~= "string" or not Engines:FindFirstChild(EngineId) then return nil end
    local Prefix = EngineId:match("(inline%-%d+)$")
      or EngineId:match("(flat%-%d+)$") or EngineId:match("(v%d+)$")
    if Prefix then rawset(Cache, CarName, Prefix) end
    return Prefix
  end
})
