end
local BuyCar = F:WaitForChild("BuyJunkyardCar")
local ExitWorkshop = E:WaitForChild("RequestExitPlayerShop")
local EnterWorkshop = F:WaitForChild("ShopVisitEnterOwn")
local JunkyardUpdated = E:WaitForChild("JunkyardUpdated")
local FinishLoading = E:WaitForChild("LoadingScreenFinished")
local ActiveCars, Scanned = {}, {}
local AutoHopRunning, ScanQueued = false, false
local JunkyardRotation = 0

local function EligibleCars()
  local Result, Seen = {}, {}
  local function Add(Id, Price, Model, Name)
    if typeof(Id) ~= "string" or Id == "" then return end
    if typeof(Price) ~= "number" or Price < 0 or not MatchesTarget(Name) then return end
    if Scanned[Id] or Seen[Id] then return end
    Seen[Id] = true
    table.insert(Result, {Id = Id, Price = Price, Model = Model, Name = Name})
  end
  for _, Car in ipairs(ActiveCars) do
    if typeof(Car) == "table" then Add(Car.Uuid, Car.Price, nil, Car.DirId) end
  end
  if Player:GetAttribute("InShopInterior") == false then
    local EventNames = {}
    for _, Car in ipairs(ActiveCars) do
      if typeof(Car) == "table" and typeof(Car.Uuid) == "string" then
        EventNames[Car.Uuid] = Car.DirId
      end
    end
    local Folder = GetJunkyardCars()
    if Folder then
      for _, Model in ipairs(Folder:GetChildren()) do
        local Info = Model:FindFirstChild("__REFLECT")
        if Info then
          local UUID = Info:GetAttribute("Uuid")
          local CarName = EventNames[UUID] or Info:GetAttribute("DirId")
            or Model.Name:gsub("^Junkyard_", "")
          Add(UUID, Info:GetAttribute("Price"), Model, CarName)
        end
      end
    end
  end
  table.sort(Result, function(A, B) return A.Price > B.Price end)
  return Result
end
local function ScanJunkyard(Explore)
  if not JunkyardEnabled or JunkyardBusy or SnipeSucceeded or SnipeUncertain then return end
  if Player:GetAttribute("OnLoadingScreen") ~= false then return end
  JunkyardBusy = true
  local WasInside = Player:GetAttribute("InShopInterior") == true
  local Matches = EligibleCars()
  local Affordable = false
  for _, Car in ipairs(Matches) do
    if Car.Price <= Cash.Value then Affordable = true break end
  end
  local ShouldExit = WasInside and (Affordable or Explore)
  local Outside = not WasInside
  if ShouldExit then
    local OK = pcall(function() ExitWorkshop:FireServer("GarageDoor") end)
    Outside = OK and WaitFor(function()
      return Player:GetAttribute("InShopInterior") == false
    end, 15)
  end
  if Outside and JunkyardEnabled then
    Matches = EligibleCars()
    for _, Car in ipairs(Matches) do
      if not JunkyardEnabled or Player:GetAttribute("InShopInterior") ~= false then break end
      if Cash.Value < Car.Price or Scanned[Car.Id] then continue end
      Scanned[Car.Id] = true
      local Before = Cash.Value
      local OK, Response = pcall(function()
        return BuyCar:InvokeServer(Car.Id)
      end)
      if not OK or Response == false then
        Scanned[Car.Id] = nil
      else
        local Until = os.clock() + 2
        repeat
          if Cash.Value < Before then break end
          if Car.Model and Car.Model.Parent ~= GetJunkyardCars() then break end
          task.wait(0.1)
        until os.clock() >= Until
        if Response == true or Cash.Value < Before
          or (Car.Model and Car.Model.Parent ~= GetJunkyardCars()) then
          SnipeSucceeded = true
          AutoHopEnabled = false
          JunkyardEnabled = false
          if AutoHopToggle then AutoHopToggle:Set(false) end
          if JunkyardToggle then JunkyardToggle:Set(false) end
          pcall(function()
            Window:Popup({
              title = "Car Sniped!",
              content = string.format("%s purchased for $%s",
                Car.Name or Car.DirId or "Unknown Car", tostring(Car.Price)),
              icon = "car-front", options = {{text = "OK"}}
            })
          end)
        else
          SnipeUncertain = true
        end
      end
      if SnipeSucceeded or SnipeUncertain then break end
      task.wait(0.3)
    end
  end
  if WasInside and Outside then
    pcall(function() EnterWorkshop:InvokeServer() end)
    WaitFor(function()
