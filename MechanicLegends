  local OK, Error = pcall(function()
    local Car, Engine = ResolveMaintenanceCar(Selected)
    local Counts = {done = 0, skipped = 0, failed = {}}
    local Detached = ManualDetachedByCar[Selected.uuid] or {}
    ManualDetachedByCar[Selected.uuid] = Detached
    if Mode == "Disassemble" then
      for _, Name in ipairs(EngineOrder) do
        local Installed = Find(Engine, Name)
        if not Installed then
          Counts.skipped += 1
          continue
        end
        local Previous = {}
        for _, Part in ipairs(LooseCandidates(Name)) do Previous[Part] = true end
        local CallOK, Response = pcall(function()
          return Detach:InvokeServer(Installed)
        end)
        if not CallOK or Response == false then
          table.insert(Counts.failed, Name)
        else
          local LoosePart
          local Confirmed = WaitFor(function()
            if Find(Engine, Name) then return false end
            for _, Part in ipairs(LooseCandidates(Name)) do
              if Part == Installed or not Previous[Part] then
                LoosePart = Part
                return true
              end
            end
            return false
          end, 8)
          if Confirmed then
            Detached[Name] = LoosePart
            Counts.done += 1
          else
            table.insert(Counts.failed, Name)
          end
        end
        task.wait(CFG.ActionGap)
      end
    else
      local Used = {}
      for I = #EngineOrder, 1, -1 do
        local Name = EngineOrder[I]
        if Find(Engine, Name) then
          Counts.skipped += 1
          continue
        end
        local Part = Detached[Name]
        local Root = GetLooseRoot()
        if typeof(Part) ~= "Instance" or not Root or not Part:IsDescendantOf(Root) then
          Part = nil
        end
        if not Part then
          for _, Candidate in ipairs(LooseCandidates(Name)) do
            local JobId = Candidate:GetAttribute("CustomerJobId")
            if not Used[Candidate] and (JobId == nil or JobId == "") then
              Part = Candidate
              break
            end
          end
        end
        if not Part then
          if Name == "Intercooler" and not Detached[Name] then
            Counts.skipped += 1
          else
            table.insert(Counts.failed, Name)
          end
          continue
        end
        Used[Part] = true
        local CallOK, Response = pcall(function()
          return Install:InvokeServer(Car, Part, nil)
        end)
        local Confirmed = CallOK and Response ~= false and WaitFor(function()
          local LooseRoot = GetLooseRoot()
          return Find(Engine, Name) ~= nil
            and (not LooseRoot or not Part:IsDescendantOf(LooseRoot))
        end, 8)
        if Confirmed then
          Detached[Name] = nil
          Counts.done += 1
        else
          table.insert(Counts.failed, Name)
        end
        task.wait(CFG.ActionGap)
      end
    end
    local Action = Mode == "Disassemble" and "disassembled" or "reassembled"
    local Message = string.format("%d component(s) %s; %d already absent/present or optional.",
      Counts.done, Action, Counts.skipped)
    if #Counts.failed > 0 then
      Message ..= " Could not process: " .. table.concat(Counts.failed, ", ") .. "."
    end
    MaintenanceNotice(#Counts.failed == 0 and "Engine " .. Action or "Engine action incomplete", Message)
  end)
  ManualBusy = false
  if not OK then
    local Reason = tostring(Error):gsub("^.-:%d+: ", "")
    MaintenanceNotice("Engine action stopped", Reason)
  end
end
