local ConfigsTab = MiscTab
ConfigsTab:CreateSection({name = "Configurations", icon = 126116963775616})

local SelectedConfig

local function WriteAutoLoad(Name)
  if not FileAccess then return false end
  return pcall(function()
    if typeof(makefolder) == "function" then
      pcall(makefolder, "Rayfield")
      pcall(makefolder, "Rayfield/Configurations")
    end
    writefile(AutoLoadFile, HTTP:JSONEncode({name = Name or ""}))
  end)
end

local AutoLoadStatus = ConfigsTab:CreateText({
  name = "Current Auto-Load Config",
  text = not FileAccess and "Unavailable (file access required)"
    or AutoLoadName or "None selected",
  icon = 121808839832144
})
local function UpdateAutoLoadStatus()
  AutoLoadStatus:Set(not FileAccess and "Unavailable (file access required)"
    or AutoLoadName or "None selected")
end

local ConfigList = ConfigsTab:CreateDropdown({
  name = "Saved Configurations", options = Window:ListConfigs(),
  placeholder = "Choose a config", forgetState = true,
  callback = function(Value)
    if typeof(Value) == "table" then Value = Value[1] end
    SelectedConfig = Value
  end
})
local ConfigName = ConfigsTab:CreateInput({
  name = "Configuration Name", placeholder = "New config name",
  clearOnFocus = false, forgetState = true
})
local function RefreshConfigList(Name)
  local Names = Window:ListConfigs()
  ConfigList:Refresh(Names)
  SelectedConfig = Name or (table.find(Names, SelectedConfig) and SelectedConfig) or Names[1]
  if SelectedConfig then ConfigList:Set(SelectedConfig) end
  UpdateAutoLoadStatus()
end
local function ConfigNotice(Title, Content)
  Window:Notify({title = Title, content = Content, duration = 4})
end
local ConfigGrid = ConfigsTab:CreateGroup()

local ConfigRow = ConfigGrid:CreateGroup({ direction = "row" })
ConfigRow:CreateButton({name = "Save", icon = 126116963775616, callback = function()
  local Name = ConfigName.value
  if typeof(Name) ~= "string" or Name:match("^%s*$") then Name = SelectedConfig end
  if not Name or Name == "" then
    ConfigNotice("Config", "Enter or select a configuration name")
  elseif Window:Save(Name) then
    RefreshConfigList(Name)
    ConfigNotice("Config saved", Name)
  else
    ConfigNotice("Save failed", "Check executor file access")
  end
end})
ConfigRow:CreateButton({name = "Load", icon = 76018996254888, callback = function()
  if not SelectedConfig then return ConfigNotice("Config", "Select a saved configuration") end
  if Window:Load(SelectedConfig) then
    ConfigNotice("Config loaded", SelectedConfig)
  else
    ConfigNotice("Load failed", SelectedConfig)
  end
end})
ConfigsTab:CreateButton({name = "Save Current As Auto Load", icon = 138133190015277, callback = function()
  local Name = SelectedConfig or "WayFinder Auto"
  if not FileAccess then return ConfigNotice("Save failed", "Executor file access required") end
  if not Window:Save(Name) then return ConfigNotice("Save failed", "Unable to save configuration") end
  if not WriteAutoLoad(Name) then return ConfigNotice("Auto load failed", "Unable to save startup preference") end
  AutoLoadName = Name
  RefreshConfigList(Name)
  ConfigNotice("Auto load updated", Name)
end})
ConfigRow:CreateButton({name = "Delete", icon = 87085435778560, callback = function()
  local Name = SelectedConfig
  if not Name or not table.find(Window:ListConfigs(), Name) then
    return ConfigNotice("Config", "Select a saved configuration to delete")
  end
  Window:Popup({
    title = "Delete configuration?",
    content = 'Permanently delete "' .. Name .. '"? This cannot be undone.',
    icon = 87085435778560,
    options = {
      {text = "Cancel"},
      {text = "Delete", style = "danger", callback = function()
        local AutoConfig = AutoLoadName == Name
        if AutoConfig and not WriteAutoLoad(nil) then
          return ConfigNotice("Delete failed", "Unable to clear auto-load preference")
        end
        local OK, Deleted = pcall(function() return Window:DeleteConfig(Name) end)
        if not OK or not Deleted then
          if AutoConfig then WriteAutoLoad(Name) end
          return ConfigNotice("Delete failed", "Unable to delete " .. Name)
        end
        if AutoConfig then
          AutoLoadName = nil
          if AutoHopEnabled then
            AutoHopEnabled = false
            if AutoHopToggle then AutoHopToggle:Set(false, true) end
          end
        end
        SelectedConfig = nil
        RefreshConfigList()
        ConfigNotice("Config deleted", Name)
      end}
    }
  })
end})
ConfigsTab:CreateButton({name = "Clear Auto Load", icon = 87085435778560, callback = function()
  if WriteAutoLoad(nil) then
    AutoLoadName = nil
    if AutoHopEnabled then
      AutoHopEnabled = false
      if AutoHopToggle then AutoHopToggle:Set(false, true) end
    end
    UpdateAutoLoadStatus()
    ConfigNotice("Auto load cleared", "No config will auto-load")
  else
    ConfigNotice("Auto load failed", "Executor file access required")
  end
end})
ConfigsTab:CreateButton({name = "Refresh Config List", icon = 117913330389477, callback = function()
  RefreshConfigList()
end})
RefreshConfigList()

local function ArrangeConfigButtonsRow()
  local function FindElementRoot(Texts)
    local SearchRoots = {game:GetService("CoreGui"), Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")}
    for _, Root in ipairs(SearchRoots) do
      if Root then
        for _, Gui in ipairs(Root:GetDescendants()) do
          if (Gui:IsA("TextLabel") or Gui:IsA("TextButton")) and table.find(Texts, Gui.Text) then
            local Node = Gui
            while Node and Node.Parent do
              if Node.Parent:FindFirstChildWhichIsA("UIListLayout") then
                return Node
              end
              Node = Node.Parent
            end
          end
        end
      end
    end
  end

  for _ = 1, 30 do
    local SaveRoot = FindElementRoot({"Save", "Save Config"})
    local LoadRoot = FindElementRoot({"Load", "Load Config"})
    local DeleteRoot = FindElementRoot({"Delete", "Delete Config"})
    if SaveRoot and LoadRoot and DeleteRoot and SaveRoot.Parent == LoadRoot.Parent and SaveRoot.Parent == DeleteRoot.Parent then
      local Parent = SaveRoot.Parent
      if Parent:FindFirstChild("WayfinderConfigButtonRow") then return end
      local Height = math.max(SaveRoot.AbsoluteSize.Y, LoadRoot.AbsoluteSize.Y, DeleteRoot.AbsoluteSize.Y, 42)
      local Row = Instance.new("Frame")
      Row.Name = "WayfinderConfigButtonRow"
      Row.BackgroundTransparency = 1
      Row.Size = UDim2.new(1, 0, 0, Height)
      Row.LayoutOrder = math.min(SaveRoot.LayoutOrder or 0, LoadRoot.LayoutOrder or 0, DeleteRoot.LayoutOrder or 0)
      Row.Parent = Parent

      local Grid = Instance.new("UIGridLayout")
      Grid.CellPadding = UDim2.new(0, 6, 0, 0)
      Grid.CellSize = UDim2.new(1/3, -4, 0, Height)
      Grid.FillDirectionMaxCells = 3
      Grid.SortOrder = Enum.SortOrder.LayoutOrder
      Grid.Parent = Row

      for Index, Element in ipairs({SaveRoot, LoadRoot, DeleteRoot}) do
        Element.LayoutOrder = Index
        Element.Parent = Row
      end
      return
    end
    task.wait(0.25)
  end
end

task.spawn(ArrangeConfigButtonsRow)

