local function TaskDone(Task)
  if Task:GetAttribute("IsComplete") == true then return true end
  if Task:GetAttribute("IsComplete") == false then return false end
  local P = Task:GetAttribute("Progress")
  local Required = Task:GetAttribute("RequiredProgress")
  return typeof(P) == "number" and typeof(Required) == "number"
    and Required > 0 and P >= Required
end
local function IsInspectionJob(Job)
  if Normalize(Job:GetAttribute("Type")) == "vehicleinspection" then
    return true, "job Type=VehicleInspection"
  end
  local Tasks = Job:FindFirstChild("Tasks")
  if not Tasks then return false end

  for _, Task in ipairs(Tasks:GetChildren()) do
    if tonumber(Task.Name) and not TaskDone(Task) then
      local TaskType = Normalize(Task:GetAttribute("Type"))
      local Target = Normalize(Task:GetAttribute("Target"))
      local Label = Normalize(Task:GetAttribute("Name"))
      local Description = Normalize(Task:GetAttribute("Description"))
      if TaskType == "vehicleinspection"
        or TaskType == "inspectvehicle"
        or TaskType == "inspectthevehicle"
        or (TaskType == "inspect" and Target == "vehicle")
        or (TaskType == "inspection" and Target == "vehicle")
        or Target == "vehicleinspection"
        or Target == "inspectvehicle"
        or Target == "inspectthevehicle"
        or Label == "inspectthevehicle"
        or Description == "inspectthevehicle" then
        return true, "task " .. Task.Name .. " (" ..
          tostring(Task:GetAttribute("Type")) .. "/" ..
          tostring(Task:GetAttribute("Target")) .. ")"
      end
    end
  end
  return false
end
